function fecharModal() {
    var l = 0;
    //reset do form e do mapa
    lista.forEach((lista) => {
        document.getElementById(Object.keys(siglaUf)[l++]).style.cssText =
            'fill:#5D5A56;' +
            'transition:500ms linear';
    });
    document.querySelector('.svgMapContainer').style.cssText =
        ' background-color: #CCC;';
    houveFiltro = false;
    $("#selectTipoDfes").val('0');
}
function carregaTabela() {

    for (var i = 26; i > 0; i--) {
        if (i >= 24) {
            var ultimoElemento = listaOrdenada[i];
            var resultadoPorcentagem = ((ultimoElemento.QtdDfe * 100) / somaTotal).toPrecision(4)
            document.querySelector('.codUf' + i).innerHTML = codUf[ultimoElemento.CodUf];
            document.querySelector('.qtdDfes' + i).innerHTML = abreviaValores(ultimoElemento.QtdDfe)//.toLocaleString('pt-br') + ",00";
            document.querySelector('.porcertagemDfes' + i).innerHTML = resultadoPorcentagem > 0 ? resultadoPorcentagem + '%' : '0%';
        }
    }
}

function listaComDfeSelecionado(sistema, lista) {
    //quando vier a lista refazer com uma unica coluna com as qtds de Dfes emitidos fica mais facil de programar
    var propriedade = {}
    var listaNova = lista.map(item => {
        switch (sistema) {
            case "Nfe":
                propriedade = {
                    "QtdDfe": item.QtdAutoizNfe,
                    "CodUf": item.CodUf,
                    "Modelo": item.Modelo
                };
                break;
            case "Cte":
                propriedade = {
                    "QtdDfe": item.QtdAutoizCte,
                    "CodUf": item.CodUf,
                    "Modelo": item.Modelo
                };
                break;
            case "Nfcom":
                propriedade = {
                    "QtdDfe": item.QtdAutorizNfcom,
                    "CodUf": item.CodUf,
                    "Modelo": item.Modelo
                };
                break;
            case "Bpe":
                propriedade = {
                    "QtdDfe": item.QtdAutoizBpe,
                    "CodUf": item.CodUf,
                    "Modelo": item.Modelo
                };
                break;
            case "Nf3e":
                propriedade = {
                    "QtdDfe": item.QtdAutoizNf3e,
                    "CodUf": item.CodUf,
                    "Modelo": item.Modelo
                };
                break;
            case "Mdfe":
                propriedade = {
                    "QtdDfe": item.QtdAutoizMdf,
                    "CodUf": item.CodUf,
                    "Modelo": item.Modelo
                };
                break;
            case "Nfce":
                propriedade = {
                    "QtdDfe": item.QtdAutorizNfc,
                    "CodUf": item.CodUf,
                    "Modelo": item.Modelo
                };
                break;
            case "Gtve":
                propriedade = {
                    "QtdDfe": item.QtdAutoizMdf,
                    "CodUf": item.CodUf,
                    "Modelo": item.Modelo
                };
                break;

            default:
        }
        return propriedade;

    });
    return listaNova;

}
function abreviaValores(num, fixed) {
    if (num === null || num === undefined) { return null; }
    if (num === 0) { return '0'; }
    if (num <= 1000000) { return (num).toLocaleString('pt-BR', { minimumFractionDigits: fixed }); }
    fixed = (!fixed || fixed < 0) ? 0 : fixed;
    var b = (num).toPrecision(2).split("e"),
        k = b.length === 1 ? 0 : Math.floor(Math.min(b[1].slice(1), 14) / 3), // floor at decimals, ceiling at trillions
        c = k < 1 ? num.toFixed(0 + fixed) : (num / Math.pow(10, k * 3)).toFixed(1 + fixed), // divide by power
        d = c < 0 ? c : Math.abs(c), // enforce -0 is 0
        e = d + ['', '', 'Mi', 'Bi', 'Tri'][k]; // append power
    return e;
}
function ResumoSistemasDfes(sistema) {
    $.ajax({
        type: "Get",
        url: sistema + "/ListarResumoDfes",
        data: {
            sistema: sistema,
            ambiente: 1
        },
        success: function (data) {
            var obj = JSON.parse(data);
            if (!obj.msgErro) {
                if (obj.lista) {

                    lista = obj.lista;
                    //console.log(lista);
                    console.log(sistema);

                    lista = listaComDfeSelecionado(sistema, lista);
                    somaTotal = lista.reduce(function (accumulator, object) {
                        return accumulator + object.QtdDfe;
                    }, 0);

                    document.querySelector('.numero-de-dfes').innerHTML = abreviaValores(somaTotal)//.toLocaleString('pt-br') + ",00";
                    listaOrdenada = lista.sort(function (a, b) {
                        return a.QtdDfe - b.QtdDfe;
                    });
                   //carregarFiltroMapa(lista);
                    carregaTabela();
                }
            } else {
                console.log(obj.msgErro);
            }
        }
    })
}





