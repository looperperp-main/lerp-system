<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Pega o nome da aplicação do application.yml/.properties -->
    <springProperty scope="context" name="springAppName" source="spring.application.name"/>

    <!-- O gateway não depende de `common`, então não tem o CorrelationIdFilter: o %X fica vazio
         aqui até alguém propagar o header. O `:-` evita virar literal "correlationId_IS_UNDEFINED". -->
    <property name="PADRAO_CONSOLE"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-}] %-5level %logger{36} - %msg%n"/>
    <!-- Sem a data: o Loki carimba o timestamp do evento, repetir só polui a linha. -->
    <property name="PADRAO_LOKI"
              value="[%thread] [%X{correlationId:-}] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PADRAO_CONSOLE}</pattern>
        </encoder>
    </appender>

    <!-- Substitui o LogstashTcpSocketAppender: push HTTP direto pro Loki, sem agente intermediário.
         Labels SÓ de baixa cardinalidade (app/host/level). tenantId, correlationId e id de pagamento
         nunca viram label — cada valor distinto criaria um stream novo e derrubaria o Loki; eles ficam
         no corpo da mensagem e se filtra com |= no LogQL. -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL:-http://localhost:3100/loki/api/v1/push}</url>
        </http>
        <format>
            <label>
                <pattern>app=${springAppName},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message>
                <pattern>${PADRAO_LOKI}</pattern>
            </message>
        </format>
    </appender>

    <!-- Loki só fora dos testes: em CI/local de teste não há sink em :3100.
         springProfile precisa envolver o <root> inteiro — não pode ser aninhado dentro dele. -->
    <springProfile name="!test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
