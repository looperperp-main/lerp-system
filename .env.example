# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env nunca deve ser commitado (já está no .gitignore).

# PostgreSQL
POSTGRES_DB=loop-erp
POSTGRES_USER=xxxxx-xxxx
POSTGRES_PASSWORD=

# Auth Service
JWT_SECRET=
DB_USER=xxxxx-xxxx
DB_PASS=
DB_HOST=localhost
DB_PORT=XXXX

# Kafka
KAFKA_BROKERS=localhost:9092

# E-mail (Gmail SMTP)
EMAIL_USER=
EMAIL_PASSWORD=

# Asaas
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# App
CLIENT_PORTAL_URL=http://localhost:4200
SYAX_INTERNAL_EMAIL=admin@syax.com.br
SYAX_ADMIN_URL=http://localhost:4300
BILLING_SERVICE_URL=http://localhost:8088
CEP_SERVICE_URL=https://viacep.com.br/ws

# Pool de conexões (opcional — padrão: 10/3)
# DB_POOL_MAX=10
# DB_POOL_MIN=3

# Logging (opcional — padrão: INFO)
# LOG_LEVEL=INFO