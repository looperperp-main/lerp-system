<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="springAppName" source="spring.application.name"/>

    <!-- correlationId vem do MDC (CorrelationIdFilter lê o header X-Correlation-ID). -->
    <property name="PADRAO_CONSOLE"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-}] %-5level %logger{36} - %msg%n"/>
    <property name="PADRAO_LOKI"
              value="[%thread] [%X{correlationId:-}] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PADRAO_CONSOLE}</pattern>
        </encoder>
    </appender>

    <!-- Labels SÓ de baixa cardinalidade (app/host/level): tenantId, batchId e correlationId
         ficam no corpo da mensagem e se filtram com |= no LogQL. -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL:-http://localhost:3100/loki/api/v1/push}</url>
        </http>
        <format>
            <label>
                <pattern>app=${springAppName},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message>
                <pattern>${PADRAO_LOKI}</pattern>
            </message>
        </format>
    </appender>

    <springProfile name="!test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
