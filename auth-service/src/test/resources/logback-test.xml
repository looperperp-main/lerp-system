<?xml version="1.0" encoding="UTF-8"?>
<!--
  Config de logback SÓ para testes. O logback carrega este arquivo com precedência
  sobre logback-spring.xml no classpath de teste, então o Loki4jAppender (destino
  localhost:3100, que não existe em CI/local de teste) nunca é criado.

  Motivo: os @WebMvcTest rodam sob o profile "default" (não "test"), então o gate
  <springProfile name="!test"> do logback-spring.xml NÃO exclui o appender. Com o
  LogstashTcpSocketAppender isso custava ~60s por classe (backoff de reconexão de 30s do
  disruptor) + 30s no fim (Surefire "going to kill self fork JVM"); o loki4j é assíncrono
  e não trava a JVM, mas cada batch falho vira ERROR no output. Só console aqui = testes
  rápidos e sem ruído.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>